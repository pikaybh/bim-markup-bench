# Audited official Python 3.12.16 slim-bookworm linux/amd64 manifest, 2026-11-05.
# NEVER use a mutable base tag or linux/arm64 manifest on this Windows x64 host.
FROM docker.io/library/python:3.12-slim-bookworm@sha256:0f086103b026048cc50cb5da25ec435c023c5241a83fc44daea593377abc61c4
LABEL org.opencontainers.image.title="bim-markup-bench isolated IFC4X3 worker" \
      org.opencontainers.image.description="Own trusted synthetic IFC worker, linux/amd64, no live LLM or GT" \
      org.opencontainers.image.version="0.1.0"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PIP_NO_CACHE_DIR=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1
WORKDIR /opt/ifc_worker
COPY docker/ifc_worker/requirements.amd64.lock /opt/ifc_worker/requirements.lock
RUN python -m pip install --disable-pip-version-check --no-cache-dir \
    --require-hashes --only-binary=:all: -r /opt/ifc_worker/requirements.lock \
    && python -c "import ifcopenshell,numpy,shapely; assert ifcopenshell.version == '0.8.4.post1'"
COPY docker/ifc_worker/trusted_probe.py /opt/ifc_worker/trusted_probe.py
COPY docker/ifc_worker/run_candidate.py /opt/ifc_worker/run_candidate.py
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/python3"]
CMD ["/opt/ifc_worker/trusted_probe.py"]
