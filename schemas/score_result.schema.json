{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:bim-markup-bench:independent-ifc-scorer:v0.1",
  "title":"Independent IFC-only geometry/semantics/topology score; NOT BIM-Edit official",
  "type":"object",
  "required":[
    "scorer_version","metric_origin","official_bim_edit_evaluator_equivalent",
    "task_id","operation","target_class","source_ifc_sha256",
    "ground_truth_ifc_sha256","result_ifc_sha256","status",
    "geometry","semantics","topology","final_score",
    "strict_pass","strict_threshold_per_axis","geometry_detail",
    "semantics_detail","topology_detail","collateral_detail",
    "target_matching_method","confidence","failure_codes",
    "model_provider_calls","source_or_gt_mutated","scored_official_dataset"
  ],
  "properties":{
    "scorer_version":{"const":"independent-ifc-three-axis-v0.1"},
    "metric_origin":{"const":"independent-reimplementation"},
    "official_bim_edit_evaluator_equivalent":{"const":false},
    "task_id":{"type":"string","minLength":1},
    "operation":{"enum":["create","update","delete"]},
    "target_class":{"enum":["IfcWall","IfcSlab","IfcSpace","IfcDoor","IfcWindow","IfcColumn","IfcOpeningElement"]},
    "source_ifc_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "ground_truth_ifc_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "result_ifc_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},
    "status":{"enum":[
      "INDEPENDENT_IFC_SCORED","INVALID_OUTPUT_IFC",
      "BLOCKED_REFERENCE_IFC_INVALID","BLOCKED_UNSUPPORTED_REFERENCE_TASK",
      "BLOCKED_REFERENCE_GEOMETRY_UNAVAILABLE","BLOCKED_IFC_UNIT_MISMATCH","DATA_MUTATED_DURING_SCORING"
    ]},
    "geometry":{"type":["number","null"],"minimum":0,"maximum":1},
    "semantics":{"type":["number","null"],"minimum":0,"maximum":1},
    "topology":{"type":["number","null"],"minimum":0,"maximum":1},
    "final_score":{"type":["number","null"],"minimum":0,"maximum":1},
    "strict_pass":{"type":"boolean"},
    "strict_threshold_per_axis":{"const":0.98},
    "geometry_detail":{"type":["object","null"]},
    "semantics_detail":{"type":["object","null"]},
    "topology_detail":{"type":["object","null"]},
    "collateral_detail":{"type":["object","null"]},
    "target_matching_method":{"type":"string"},
    "confidence":{"type":"string"},
    "failure_codes":{"type":"array","items":{"type":"string"}},
    "model_provider_calls":{"const":0},
    "source_or_gt_mutated":{"type":"boolean"},
    "scored_official_dataset":{"const":false}
  },
  "additionalProperties":false
}
