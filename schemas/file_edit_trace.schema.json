{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:bim-markup-bench:source-only-file-trace:v0",
  "type":"object",
  "required":["task_id","mode","context_mode","attempt_count","maximum_attempts",
              "max_wall_seconds","accepted_valid_xml","source_ifc_sha256","events",
              "tool_access_boundary","trusted_compiler_visible_to_agent",
              "real_model_provider_called"],
  "properties":{
    "task_id":{"type":"string","minLength":1},
    "mode":{"enum":["one_shot","feedback"]},
    "context_mode":{"const":"xml_projection"},
    "attempt_count":{"type":"integer","minimum":0},
    "maximum_attempts":{"type":"integer","minimum":1,"maximum":5},
    "max_wall_seconds":{"type":"number","exclusiveMinimum":0},
    "accepted_valid_xml":{"type":"boolean"},
    "source_ifc_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "events":{"type":"array","items":{
      "type":"object",
      "required":["attempt","status","operation","filename","before_sha256",
                  "after_sha256","unified_diff","agent_declared_success",
                  "agent_tools_used","agent_BIM_API_calls",
                  "real_model_provider_called","actual_model_tokens","elapsed_wall_ms"],
      "properties":{
        "attempt":{"type":"integer","minimum":0},
        "status":{"enum":["READ","ACCEPTED_VALID_XML","REJECTED","REJECTED_TOOL"]},
        "operation":{"enum":["read_text","edit_xml_text","tool_denied"]},
        "filename":{"const":"building.xml"},
        "before_sha256":{"type":["string","null"]},
        "after_sha256":{"type":["string","null"]},
        "unified_diff":{"type":"string"},
        "agent_declared_success":{"type":"boolean"},
        "agent_tools_used":{"type":"array","items":{"type":"string"}},
        "agent_BIM_API_calls":{"const":0},
        "real_model_provider_called":{"const":false},
        "actual_model_tokens":{"type":"null"},
        "elapsed_wall_ms":{"type":"integer","minimum":0}
      },
      "additionalProperties":false
    }},
    "tool_access_boundary":{"const":"FILE_TEXT_ONLY_NOT_OS_SANDBOX"},
    "trusted_compiler_visible_to_agent":{"const":false},
    "real_model_provider_called":{"const":false}
  },
  "additionalProperties":false
}
